       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Skin tone scales for equitable skin assessment. Monk (A-J) is the primary, recommended scale; Fitzpatrick (I-VI) is retained only for backward compatibility with legacy systems." ] ;
