  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example-device-use"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://opennursingcoreig.com/StructureDefinition/onc-device-use-statement" ;
